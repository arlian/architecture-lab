# Multi-stage build. Build context is the WORKSPACE ROOT (fan-out/) — see
# docker-compose.yml (`context: .`).

FROM rust:1-slim-bookworm AS builder
RUN apt-get update \
    && apt-get install -y --no-install-recommends pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . .
RUN cargo build --release -p search-gateway

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libssl3 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/target/release/search-gateway /usr/local/bin/search-gateway
ENV PORT=3010
EXPOSE 3010
CMD ["search-gateway"]
